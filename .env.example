DB_PATH=./data/tinynotes.db
APP_URL=http://localhost:3000
# Generate a random secret with: openssl rand -base64 32
AUTH_SECRET=
# Stable 32-byte base64url key for recovering public links (separate from AUTH_SECRET).
# Generate with: bun -e 'console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString("base64url"))'
SHARE_TOKEN_SECRET=
